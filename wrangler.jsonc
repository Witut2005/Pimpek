{
  "name": "hackyeah",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./frontend/dist/frontend/browser",
    "binding": "ASSETS",
    // Angular routes (/wardrobe, ...) fall back to index.html.
    "not_found_handling": "single-page-application",
    // Only /api reaches the Worker; everything else is served straight from assets.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Public URL of the FastAPI backend (no trailing slash), e.g. an ngrok tunnel.
    "BACKEND_URL": ""
  }
}
