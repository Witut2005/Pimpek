# Where per-user Garmin tokens are stored (never commit this directory)
TOKEN_DIR=data/tokens
# Origins allowed to call this API (comma separated)
CORS_ORIGINS=http://localhost:4200

# Open Wearables (self-hosted, https://openwearables.io). It defaults to port 8000,
# so run this backend on another port (e.g. 8001) or remap Open Wearables.
OPEN_WEARABLES_URL=http://localhost:8000
OPEN_WEARABLES_API_KEY=
