# Where per-user Garmin tokens are stored (never commit this directory)
TOKEN_DIR=data/tokens
# Origins allowed to call this API (comma separated)
CORS_ORIGINS=http://localhost:4200

# Open Wearables (self-hosted, https://openwearables.io). It defaults to port 8000,
# so run this backend on another port (e.g. 8001) or remap Open Wearables.
OPEN_WEARABLES_URL=http://localhost:8000
OPEN_WEARABLES_API_KEY=
# Providers whose OAuth client id/secret you put into open-wearables/backend/config/.env,
# comma separated, e.g. garmin,polar,fitbit,oura,whoop,withings. Only these get a "Połącz" button.
OPEN_WEARABLES_PROVIDERS=

# AI food rating (Gemini). Get a key at https://aistudio.google.com/apikey.
# Empty: the app still works and shows a rough estimate instead of the AI rating.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried when the main model stays overloaded ("high demand", HTTP 503). Empty: no fallback.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Requests per minute to each Gemini endpoint, per X-User-Id and per client IP (429 above that).
AI_RATE_LIMIT_PER_USER=10
AI_RATE_LIMIT_PER_IP=60
